# Ledgerline registry configuration. Reviewed under DEPENDENCY_POLICY.md; changes need @northgate/gis-appsec.
#
# Locally the estate serves the @northgate scope from Verdaccio on 4873 (mock-external/estate-up.sh).
# On the nodejs18-rhel9 agents the same scope resolves through the Artifactory virtual repo; the
# agent image drops its own .npmrc via the Vault agent, so nothing in here is edited for a pipeline.
@northgate:registry=http://127.0.0.1:4873
# @northgate:registry=https://artifactory.northgate.internal/artifactory/api/npm/npm-northgate-virtual/

# @northgate/canopy-ui 3.7.2 declares Angular 14 peers and we are on 16. Until Canopy ships a
# 4.x built against a current Angular (CNPY-2140, no date) the peer check has to be relaxed here,
# and patches/@northgate+canopy-ui+3.7.2.patch carries the rest. See patches/README.md and LDG-1187.
legacy-peer-deps=true

save-exact=true
fund=false
audit=false

# Cypress binary is baked into the agent image (CYPRESS_INSTALL_BINARY=0 on the agent side);
# developers on laptops let the download happen once.
